// VeriRoll - SQLite version for zero-setup local dev.
// SQLite has no native enum support in Prisma, so enum fields below are
// plain String with a comment listing the allowed values. Application
// code already uses string literals ('STUDENT', 'PRESENT', etc.), so
// nothing else needs to change. Swap back to schema.postgres.prisma
// (kept alongside this file) when you're ready for a real database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          String   // "STUDENT" | "LECTURER" | "ADMIN"
  authProvider  String   // "GOOGLE" | "MICROSOFT"
  providerId    String
  createdAt     DateTime @default(now())

  enrollments       Enrollment[]
  lecturerUnits     CourseUnit[]        @relation("LecturerAssignment")
  attendanceRecords AttendanceRecord[]  @relation("StudentAttendance")
  editedRecords     AttendanceRecord[]  @relation("EditedBy")
  auditLogs         AuditLog[]

  @@index([email])
}

model CourseUnit {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  lessonsPlanned Int
  createdAt      DateTime @default(now())

  lecturers   User[]        @relation("LecturerAssignment")
  enrollments Enrollment[]
  sessions    Session[]

  @@index([code])
}

model Enrollment {
  id           String   @id @default(cuid())
  student      User     @relation(fields: [studentId], references: [id])
  studentId    String
  courseUnit   CourseUnit @relation(fields: [courseUnitId], references: [id])
  courseUnitId String
  source       String   @default("PORTAL") // "PORTAL" | "MANUAL"
  createdAt    DateTime @default(now())

  @@unique([studentId, courseUnitId])
  @@index([courseUnitId])
}

model Session {
  id             String   @id @default(cuid())
  courseUnit     CourseUnit @relation(fields: [courseUnitId], references: [id])
  courseUnitId   String
  lectureNumber  Int
  status         String   @default("OPEN") // "OPEN" | "CLOSED"
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  autoCloseAt    DateTime

  attendanceRecords AttendanceRecord[]

  @@index([courseUnitId, status])
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  session    Session  @relation(fields: [sessionId], references: [id])
  sessionId  String
  student    User     @relation("StudentAttendance", fields: [studentId], references: [id])
  studentId  String
  status     String   // "PRESENT" | "ABSENT"
  method     String   // "SELF" | "MANUAL" | "AUTO_ABSENT"
  recordedAt DateTime @default(now())

  editedBy   User?    @relation("EditedBy", fields: [editedById], references: [id])
  editedById String?
  editedAt   DateTime?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}
